# Instance identity
INSTANCE_ID=instance-1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://notify:notify@localhost:5432/notifications

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (issued by the upstream auth service, verified here)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# WebSocket ticket exchange
WS_TICKET_TTL_SECONDS=10

# Presence
PRESENCE_TTL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=15

# Per-instance liveness key, refreshed independently of any user's presence
INSTANCE_LIVENESS_TTL_SECONDS=15

# Backlog delivery on connect
BACKLOG_LIMIT=100

# Per-connection rate limiting
RATE_LIMIT_MESSAGES=50
RATE_LIMIT_WINDOW_SECONDS=10

# Per-caller rate limiting on POST /notifications
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW_SECONDS=10

# Logging
LOG_LEVEL=INFO
